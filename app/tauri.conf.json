{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4YouPDF",
  "version": "0.1.0",
  "identifier": "org.4youpdf.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "4YouPDF",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
