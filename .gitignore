/target
/fuzz/target
/fuzz/artifacts
/fuzz/corpus
# Crates outside the workspace: their lockfiles and builds stay local
/fuzz/Cargo.lock
/tools/bench_host/Cargo.lock
/tools/bench_host/target
/app/node_modules
/app/dist
# Fetched by tools/fetch_ui_tools.py and tools/fetch_pdfium.py
/app/.tools
/app/pdfium
# Generated by tauri-build
/app/gen
# Built by tools/build_modules.py from each module's crate
/plugins/*/module.wasm
*.log
.DS_Store

/tests/corpus-private/
# Public test suites fetched by tools/fetch_corpus.py: one sub-directory per
# lot, documented in tests/corpus/SOURCES.md. Only the Markdown files at the
# top of tests/corpus/ are tracked.
/tests/corpus/*/
